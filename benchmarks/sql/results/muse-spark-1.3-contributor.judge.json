          "command": "cd \"<eval>/sql/muse-spark-1.3-contributor\" && cat > <tmp> << 'EOF'\nimport { execute } from './src/index.ts';\nEOF\nnode --experimental-strip-types -e \"\nimport('./src/index.ts').then(async ({execute}) => {\n  const tests = [\n    () => execute({t:{columns:['a'],rows:[[1],[2]]}}, 'SELECT a, COUNT(*) FROM t'), // agg mixed with non-group col - should error in sqlite? Actually sqlite allows but picks arbitrary row\n    () => execute({t:{columns:['a'],rows:[[1],[2],[null]]}}, 'SELECT a FROM t WHERE a = NULL'), // = NULL always null/false\n    () => execute({}, 'SELECT CAST(1 AS TEXT)'), // not supported per spec; should throw\n    () => execute({t:{columns:['a'],rows:[[1]]}}, 'SELECT t.a FROM t GROUP BY t.a HAVING COUNT(*) > 0'),\n    () => execute({}, \\\"SELECT 'abc' LIKE 'a\\_c' ESCAPE '\\\\\\\\'\\\"), // escape clause - not required\n  ];\n  for (const t of tests) {\n    try {\n      console.log(JSON.stringify(t()));\n    } catch(e) {\n      console.log('ERR', e.message);\n    }\n  }\n});\n\" 2>&1 | tail -30\n"
